server {
    listen       443 ssl http2;
    server_name  {{DOMAIN}};
    ssl_certificate     /etc/ssl/origin/{{DOMAIN}}/fullchain.pem;
    ssl_certificate_key /etc/ssl/origin/{{DOMAIN}}/privkey.pem;
    include      snippets/ssl.conf;

    location / {
        include     snippets/proxy.conf;
        proxy_pass  http://{{UPSTREAM_HOST}}:{{UPSTREAM_PORT}};
    }
}